# Periode telechargée depuis l'API SODA (Chicago Taxi Trips) : 1er semestre de 2023
SODA_START_DATE=2023-01-01
SODA_END_DATE=2023-07-01
# Optionnel : token d'app Socrata pour augmenter le rate limit
# https://data.cityofchicago.org/profile/app_tokens
SODA_APP_TOKEN=

# Stockage objet MinIO (S3-compatible), socle du datalake
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=taxi-datalake
